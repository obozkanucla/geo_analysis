# Still allow small files
!data/postcode_centroids_small.csv
!data/*.geojson

# Block all other CSVs by default
data/*.csv

# But explicitly allow the specific ones we need:
!data/postcode_centroids_small.csv
!data/PopulationStatsByLADDetail_aggregated.csv

