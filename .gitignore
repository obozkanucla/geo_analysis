# ======================
# EXCLUDE LARGE DATA FILES
# ======================
data/ONSPD_Centroids.csv
data/PCD_OA21_LSOA21_MSOA21_LAD_MAY25_UK_LU.csv
data/postcode_to_lad.csv
data/PopulationStatsByLADDetail_merged.csv
data/LAD_MAY_2025_UK_BGC_V2_1110015208521213948.csv
data/PopulationStatsByLADDetail.csv
data/HomeCareAgencies_data (08-09-2025)(ALL_CQC_RATINGS)_postcodes.csv
